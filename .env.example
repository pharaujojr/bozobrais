# ===== Servidor / rede =====
# IP LAN do host, anunciado pelo WebRTC (ICE). Troque se o IP mudar.
SERVER_IP=192.168.1.10
# Fuso das gravações e da agenda da luz
TZ=America/Sao_Paulo

# ===== Portas (todas > 3000, o provedor bloqueia até 3000) =====
API_PORT=8091          # web + API REST (entrada principal)
RTSP_PORT=8554
HLS_PORT=8888
WEBRTC_PORT=8889
WEBRTC_UDP_PORT=8189
MTX_API_PORT=9997      # API interna do MediaMTX (só localhost)

# ===== Armazenamento (todas as câmeras somadas) =====
# Teto RÍGIDO. O pruner apaga os segmentos mais antigos p/ nunca passar disto.
MAX_STORAGE_GB=220

# ===== GPU =====
# 1 = NVDEC/NVENC (NVIDIA, câmeras H.265). 0 = tudo na CPU (libx264); remova também os
# "runtime: nvidia" do docker-compose.yml se não houver placa NVIDIA.
USE_GPU=1
PRUNE_TRIGGER_PCT=95

# ===== Segurança =====
# Login único. Protege TUDO (site + API). O site entra pela tela /login (cookie de
# sessão de SESSION_DAYS dias, renovado em uso); o app mobile envia o header X-API-Key.
# Trocar a senha derruba todas as sessões abertas.
AUTH_USER=admin
# Senha forte: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=
SESSION_DAYS=365

# ===== Acesso remoto (cloudflared) =====
# Vazio = LAN (usa IP:porta do host). Ao expor por cloudflared, coloque aqui as
# URLs públicas dos streams (sem barra final). Ex.:
#   PUBLIC_HLS_BASE=https://cam-hls.seudominio.com
#   PUBLIC_WEBRTC_BASE=https://cam-webrtc.seudominio.com
PUBLIC_HLS_BASE=
PUBLIC_WEBRTC_BASE=
